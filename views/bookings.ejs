<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Booking History' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="h2 mb-0">Booking History</h1>
      <a href="/services" class="btn btn-primary">Book a Service</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <!-- Spending summary cards -->
    <% if (summary && summary.total_bookings > 0) { %>
    <div class="row g-3 mb-4">
      <div class="col-sm-4">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-3 fw-bold text-primary"><%= summary.total_bookings %></div>
            <div class="text-secondary small">Total Bookings</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-3 fw-bold text-success">S$<%= Number(summary.total_spent).toFixed(2) %></div>
            <div class="text-secondary small">Total Spent</div>
          </div>
        </div>
      </div>
      <div class="col-sm-4">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-3 fw-bold text-info"><%= summary.favourite_service || '—' %></div>
            <div class="text-secondary small">Most Booked Service</div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <% if (!bookings.length) { %>
      <div class="alert alert-info">You have no bookings yet.</div>
    <% } else { %>
      <div class="table-responsive">
        <table class="table table-striped table-hover align-middle">
          <thead class="table-dark">
            <tr>
              <th scope="col">Booking #</th>
              <th scope="col">Date</th>
              <th scope="col">Pet</th>
              <th scope="col">Service</th>
              <th scope="col">Price</th>
              <th scope="col">Booking Status</th>
              <th scope="col">Payment Status</th>
            </tr>
          </thead>
          <tbody>
            <% for (let i = 0; i < bookings.length; i++) { %>
              <tr>
                <td><%= bookings[i].booking_id %></td>
                <td><%= bookings[i].booking_date %></td>
                <td><%= bookings[i].pet_name %></td>
                <td><%= bookings[i].service_name %></td>
                <td>S$<%= Number(bookings[i].booked_price).toFixed(2) %></td>
                <td><span class="badge text-bg-secondary"><%= bookings[i].booking_status %></span></td>
                <td>
                  <% if (bookings[i].payment_status) { %>
                    <span class="badge text-bg-secondary"><%= bookings[i].payment_status %></span>
                  <% } else { %>
                    <span class="text-secondary">No payment record</span>
                  <% } %>
                </td>
              </tr>
            <% } %>
          </tbody>
        </table>
      </div>
      <p class="text-secondary">Payments are pending. No payment has been processed by this app.</p>
    <% } %>
  </main>

  <%- include('partials/scripts') %>
</body>
</html>