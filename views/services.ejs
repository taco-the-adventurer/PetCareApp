<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Book a Pet Service</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
      <h1 class="h2 mb-0">Book a Pet Service</h1>
      <a href="/bookings" class="btn btn-outline-secondary">View Booking History</a>
    </div>

    <% if (messages && messages.length) { %>
      <% for (let i = 0; i < messages.length; i++) { %>
        <div class="alert alert-success" role="status"><%= messages[i] %></div>
      <% } %>
    <% } %>
    <% if (errors && errors.length) { %>
      <% for (let i = 0; i < errors.length; i++) { %>
        <div class="alert alert-danger" role="alert"><%= errors[i] %></div>
      <% } %>
    <% } %>

    <% if (!pets.length) { %>
      <div class="alert alert-info">
        Add a pet before booking a service. <a href="/pets/new">Add a pet</a>
      </div>
    <% } else if (!services.length) { %>
      <div class="alert alert-info">There are no services available to book right now.</div>
    <% } else { %>
      <form action="/services/book" method="POST">
        <div class="row g-3 mb-4">
          <div class="col-md-6">
            <label for="petId" class="form-label">Pet</label>
            <select id="petId" name="petId" class="form-select" required>
              <option value="">Select a pet</option>
              <% for (let i = 0; i < pets.length; i++) { %>
                <option value="<%= pets[i].id %>" <%= selectedPetId === String(pets[i].id) ? 'selected' : '' %>>
                  <%= pets[i].name %> (<%= pets[i].species %>)
                </option>
              <% } %>
            </select>
          </div>
          <div class="col-md-6">
            <label for="bookingDate" class="form-label">Booking date</label>
            <input id="bookingDate" name="bookingDate" type="date" class="form-control"
              min="<%= today %>" value="<%= today %>" required>
          </div>
        </div>

        <fieldset class="mb-4">
          <legend class="h5 mb-3">Choose a service</legend>
          <div class="row g-3">
            <% for (let i = 0; i < services.length; i++) { %>
              <div class="col-md-6 col-lg-4">
                <label class="card h-100 p-3" for="service-<%= services[i].id %>">
                  <div class="d-flex align-items-start gap-3">
                    <input class="form-check-input mt-1" id="service-<%= services[i].id %>"
                      type="radio" name="serviceId" value="<%= services[i].id %>" required>
                    <span class="d-flex justify-content-between align-items-start gap-3 w-100">
                      <span class="fw-semibold"><%= services[i].name %></span>
                      <span class="text-nowrap">S$<%= Number(services[i].price).toFixed(2) %></span>
                    </span>
                  </div>
                </label>
              </div>
            <% } %>
          </div>
        </fieldset>

        <p class="text-secondary">Bookings and payments are recorded as pending. No payment is processed here.</p>
        <button type="submit" class="btn btn-primary">Create booking</button>
      </form>
    <% } %>
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>