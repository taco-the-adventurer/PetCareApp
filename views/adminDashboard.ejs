<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Admin Dashboard' }) %>
</head>
<body>
  <%- include('partials/navbar') %>

  <main class="container py-5">
    <h1 class="h2 mb-4">Admin Dashboard</h1>
    <p class="text-secondary mb-4">Welcome, <strong><%= session.user.name %></strong>.</p>

    <% if (stats) { %>
    <!-- Stats overview -->
    <div class="row g-3 mb-5">
      <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-2 fw-bold text-primary"><%= stats.summary.total_bookings %></div>
            <div class="text-secondary small">Total Bookings</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-2 fw-bold text-success">S$<%= Number(stats.summary.total_revenue).toFixed(2) %></div>
            <div class="text-secondary small">Total Revenue</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-2 fw-bold text-warning"><%= stats.summary.pending_count %></div>
            <div class="text-secondary small">Pending Bookings</div>
          </div>
        </div>
      </div>
      <div class="col-sm-6 col-lg-3">
        <div class="card text-center shadow-sm h-100">
          <div class="card-body">
            <div class="fs-2 fw-bold text-secondary"><%= stats.summary.confirmed_count %></div>
            <div class="text-secondary small">Confirmed Bookings</div>
          </div>
        </div>
      </div>
    </div>
    <% } %>

    <!-- Quick actions -->
    <h2 class="h5 mb-3">Quick Actions</h2>
    <div class="d-flex flex-wrap gap-2">
      <a href="/admin/users" class="btn btn-dark">Manage Users</a>
      <a href="/admin/bookings" class="btn btn-primary">View All Bookings</a>
    </div>
  </main>

  <%- include('partials/scripts') %>
</body>
</html>
